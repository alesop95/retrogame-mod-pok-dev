<Project Sdk="Microsoft.NET.Sdk">
  <!-- Esemplari per le sfide dell'app di HOME raggiungibili con i giochi del 3DS (sfere, condizioni di gara, Ditto),
       generati dalla libreria del verificatore, compilata dal clone in _notes/fonti/cloni/pkhex. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PKHeX.Core">
      <HintPath>..\..\_notes\fonti\cloni\pkhex\PKHeX.Core\bin\Release\net10.0\PKHeX.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
